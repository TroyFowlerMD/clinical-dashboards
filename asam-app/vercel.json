{
  "buildCommand": "npm run build",
  "outputDirectory": "dist/public",
  "installCommand": "npm install",
  "framework": null,
  "functions": {
    "api/log.ts": { "maxDuration": 10 }
  },
  "rewrites": [
    { "source": "/api/log", "destination": "/api/log" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
